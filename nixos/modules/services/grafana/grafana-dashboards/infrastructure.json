          "expr": "node_filesystem_size_bytes{mountpoint=\"/\", instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "Disk"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-default"
          },
          "expr": "node_time_seconds{instance=~\"$instance\"} - node_boot_time_seconds{instance=~\"$instance\"}",
          "format": "table",
          "instant": true,
          "refId": "Uptime"
        }
      ],
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "instance"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true
            },
            "renameByName": {
              "Value #Cores": "CPU Cores",
              "Value #Disk": "Disk (GiB)",
              "Value #RAM": "RAM (GiB)",
              "Value #Status": "Status",
              "Value #Uptime": "Uptime",
              "instance": "Host Name"
            }
          }
        }
      ]
    }
  ]
}
