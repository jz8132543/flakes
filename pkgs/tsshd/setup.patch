@@ -0,0 +1,26 @@
+//go:build !linux
+
+package tsshd
+
+import (
+	"fmt"
+	"time"
+)
+
+type setupLease struct{ handle string }
+
+func newSetupLease(time.Duration) (*setupLease, error) {
+	return nil, fmt.Errorf("auto setup requires Linux peer credentials")
+}
+func (*setupLease) close()                        {}
+func (*setupLease) activity(time.Duration)        {}
+func (*setupLease) isPending() bool               { return false }
+func (*setupLease) authorizeStream(string) error  { return fmt.Errorf("auto setup unsupported") }
+func (*setupLease) execute() error                { return fmt.Errorf("auto setup unsupported") }
+func (*setupLease) cancel(string, int, int) error { return fmt.Errorf("auto setup unsupported") }
+func (*setupLease) confirm(string, int, time.Duration) error {
+	return fmt.Errorf("auto setup unsupported")
+}
+func handleCancelSetupCommand(string) (int, error) {
+	return kExitCodeApplyOptions, fmt.Errorf("auto setup requires Linux peer credentials")
+}
