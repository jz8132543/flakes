new file mode 100644
index 00000000..3b831352
--- /dev/null
+++ b/tsshd/setup_linux.go
@@ -0,0 +1,432 @@
+//go:build linux
+
+package tsshd
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+const setupRecordLifetime = 24 * time.Hour
+
+type setupRecord struct {
+	Handle   string
+	UID      int
+	State    string
+	Deadline int64
+}
+
+type setupLease struct {
+	mu       sync.Mutex
+	handle   string
+	uid      int
+	state    string
+	deadline time.Time
+	timer    *time.Timer
+	dir      string
+	listener net.Listener
+	onStop   func()
+}
+
+func validSetupHandle(handle string) bool {
+	if len(handle) != 64 {
+		return false
+	}
+	_, err := hex.DecodeString(handle)
+	return err == nil && strings.ToLower(handle) == handle
+}
+
+func setupPaths(dir, handle string) (string, string) {
+	return filepath.Join(dir, "setup-"+handle), filepath.Join(dir, "s-"+handle[:32])
+}
+
+func newSetupLease(timeout time.Duration) (*setupLease, error) {
+	if timeout <= 0 || timeout > time.Hour {
+		return nil, fmt.Errorf("invalid setup lease")
+	}
+	dir, err := getSocketDir()
+	if err != nil {
+		return nil, fmt.Errorf("private setup runtime directory unavailable")
+	}
+	gcSetupRecords(dir)
+	buf := make([]byte, 32)
+	if _, err := rand.Read(buf); err != nil {
+		return nil, fmt.Errorf("setup entropy unavailable")
+	}
+	lease := &setupLease{handle: hex.EncodeToString(buf), uid: os.Getuid(), state: "pending",
+		deadline: time.Now().Add(timeout), dir: dir, onStop: func() { exitWithCode(kExitCodeConnTimeout) }}
+	recordPath, socketPath := setupPaths(dir, lease.handle)
+	file, err := os.OpenFile(recordPath, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		return nil, fmt.Errorf("cannot create private setup record")
+	}
+	_ = file.Close()
+	if err := lease.storeLocked(); err != nil {
+		_ = os.Remove(recordPath)
+		return nil, err
+	}
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		_ = os.Remove(recordPath)
+		return nil, fmt.Errorf("cannot create private setup socket")
+	}
+	lease.listener = listener
+	if err := os.Chmod(socketPath, 0600); err != nil {
+		_ = listener.Close()
+		_ = os.Remove(recordPath)
+		return nil, fmt.Errorf("cannot protect setup socket")
+	}
+	lease.timer = time.AfterFunc(timeout, lease.expire)
+	go lease.serve()
+	return lease, nil
+}
+
+func (l *setupLease) storeLocked() error {
+	record := setupRecord{l.handle, l.uid, l.state, l.deadline.UnixMilli()}
+	data, _ := json.Marshal(record)
+	file, err := os.CreateTemp(l.dir, ".setup-")
+	if err != nil {
+		return fmt.Errorf("cannot write setup state")
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if _, err := file.Write(data); err != nil {
+		_ = file.Close()
+		return fmt.Errorf("cannot write setup state")
+	}
+	if err := file.Close(); err != nil {
+		return fmt.Errorf("cannot close setup state")
+	}
+	path, _ := setupPaths(l.dir, l.handle)
+	if err := os.Rename(name, path); err != nil {
+		return fmt.Errorf("cannot publish setup state")
+	}
+	return nil
+}
+
+func (l *setupLease) authenticateLocked(handle string, version, uid int) error {
+	if uid != l.uid {
+		return fmt.Errorf("setup UID mismatch")
+	}
+	if version != 1 {
+		return fmt.Errorf("unsupported setup version")
+	}
+	if !validSetupHandle(handle) || subtle.ConstantTimeCompare([]byte(handle), []byte(l.handle)) != 1 {
+		return fmt.Errorf("invalid setup token")
+	}
+	return nil
+}
+
+func (l *setupLease) confirm(handle string, version int, lifetime time.Duration) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if err := l.authenticateLocked(handle, version, os.Getuid()); err != nil {
+		return err
+	}
+	if l.state == "executing" || l.state == "ready" {
+		return nil
+	}
+	if l.state != "pending" || !time.Now().Before(l.deadline) {
+		return fmt.Errorf("setup is no longer pending")
+	}
+	if lifetime <= 0 || lifetime > setupRecordLifetime {
+		lifetime = setupRecordLifetime
+	}
+	oldDeadline := l.deadline
+	l.state, l.deadline = "ready", time.Now().Add(lifetime)
+	if err := l.storeLocked(); err != nil {
+		l.state, l.deadline = "pending", oldDeadline
+		return err
+	}
+	l.timer.Reset(lifetime)
+	return nil
+}
+
+func (l *setupLease) authorizeStream(command string) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state == "executing" {
+		return nil
+	}
+	if (l.state != "pending" && l.state != "ready") || !time.Now().Before(l.deadline) {
+		return fmt.Errorf("setup is cancelled or expired")
+	}
+	if command == "dial-udp" {
+		return nil
+	}
+	if l.state != "ready" {
+		return fmt.Errorf("setup must be explicitly confirmed before application execution")
+	}
+	return nil
+}
+
+func (l *setupLease) activity(lifetime time.Duration) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state != "ready" || !time.Now().Before(l.deadline) {
+		return
+	}
+	if lifetime <= 0 || lifetime > setupRecordLifetime {
+		lifetime = setupRecordLifetime
+	}
+	// Intermediate hops have no shell execution to stop the setup timer.
+	// After confirmation, their lifetime is an idle budget, not a session cap.
+	l.deadline = time.Now().Add(lifetime)
+	l.timer.Reset(lifetime)
+}
+
+func (l *setupLease) execute() error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.state == "executing" {
+		return nil
+	}
+	if l.state != "ready" || !time.Now().Before(l.deadline) {
+		return fmt.Errorf("setup is not confirmed or has expired")
+	}
+	l.state = "executing"
+	if err := l.storeLocked(); err != nil {
+		l.state = "ready"
+		return err
+	}
+	l.timer.Stop()
+	return nil
+}
+
+func (l *setupLease) cancel(handle string, version, uid int) error {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if err := l.authenticateLocked(handle, version, uid); err != nil {
+		return err
+	}
+	if l.state == "executing" {
+		return fmt.Errorf("setup has committed application execution")
+	}
+	if l.state == "cancelled" || l.state == "expired" {
+		return nil
+	}
+	if l.state != "pending" && l.state != "ready" {
+		return fmt.Errorf("invalid setup state")
+	}
+	oldState := l.state
+	l.state = "cancelled"
+	if err := l.storeLocked(); err != nil {
+		l.state = oldState
+		return err
+	}
+	l.timer.Stop()
+	return nil
+}
+
+func (l *setupLease) expire() {
+	l.mu.Lock()
+	if (l.state != "pending" && l.state != "ready") || time.Now().Before(l.deadline) {
+		l.mu.Unlock()
+		return
+	}
+	l.state = "expired"
+	_ = l.storeLocked()
+	l.mu.Unlock()
+	l.onStop()
+}
+
+func (l *setupLease) isPending() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return l.state == "pending"
+}
+
+func (l *setupLease) close() {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	l.timer.Stop()
+	_ = l.listener.Close()
+	if l.state != "cancelled" && l.state != "expired" {
+		path, _ := setupPaths(l.dir, l.handle)
+		_ = os.Remove(path)
+	}
+}
+
+func setupPeerUID(conn net.Conn) (int, error) {
+	unixConn, ok := conn.(*net.UnixConn)
+	if !ok {
+		return -1, fmt.Errorf("not a Unix socket")
+	}
+	raw, err := unixConn.SyscallConn()
+	if err != nil {
+		return -1, fmt.Errorf("socket credentials unavailable")
+	}
+	var cred *unix.Ucred
+	var credErr error
+	if err := raw.Control(func(fd uintptr) { cred, credErr = unix.GetsockoptUcred(int(fd), unix.SOL_SOCKET, unix.SO_PEERCRED) }); err != nil || credErr != nil || cred == nil {
+		return -1, fmt.Errorf("socket credentials unavailable")
+	}
+	return int(cred.Uid), nil
+}
+
+func (l *setupLease) serve() {
+	for {
+		conn, err := l.listener.Accept()
+		if err != nil {
+			return
+		}
+		go l.handleConn(conn)
+	}
+}
+
+func (l *setupLease) handleConn(conn net.Conn) {
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(kSocketTimeout))
+	uid, err := setupPeerUID(conn)
+	if err != nil || uid != l.uid {
+		return
+	}
+	reader := io.LimitReader(conn, 4096)
+	command, err := recvCommand(reader)
+	if err != nil || command != "setup-cancel" {
+		return
+	}
+	var msg setupMessage
+	if err := recvSetupMessage(reader, &msg); err != nil {
+		return
+	}
+	response := setupResponse{Version: 1}
+	if err := l.cancel(msg.Handle, msg.Version, uid); err != nil {
+		response.Error = err.Error()
+	}
+	_ = sendCommandAndMessage(conn, "setup-cancel", response)
+	if response.Error == "" {
+		l.onStop()
+	}
+}
+
+func validateSetupStat(stat *unix.Stat_t, uid int, socket bool) error {
+	kind := uint32(unix.S_IFREG)
+	if socket {
+		kind = unix.S_IFSOCK
+	}
+	if int(stat.Uid) != uid || stat.Mode&unix.S_IFMT != kind || stat.Mode&0077 != 0 {
+		return fmt.Errorf("setup ownership or permissions invalid")
+	}
+	return nil
+}
+
+func readSetupRecord(path, handle string, uid int) (*setupRecord, error) {
+	fd, err := unix.Open(path, unix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)
+	if err != nil {
+		return nil, fmt.Errorf("setup record unavailable")
+	}
+	file := os.NewFile(uintptr(fd), "setup-record")
+	defer file.Close()
+	var stat unix.Stat_t
+	if err := unix.Fstat(fd, &stat); err != nil {
+		return nil, fmt.Errorf("setup record unavailable")
+	}
+	if err := validateSetupStat(&stat, uid, false); err != nil {
+		return nil, err
+	}
+	var record setupRecord
+	if err := json.NewDecoder(io.LimitReader(file, 4096)).Decode(&record); err != nil {
+		return nil, fmt.Errorf("invalid setup record")
+	}
+	if record.UID != uid || !validSetupHandle(record.Handle) || subtle.ConstantTimeCompare([]byte(record.Handle), []byte(handle)) != 1 {
+		return nil, fmt.Errorf("setup record token or UID mismatch")
+	}
+	return &record, nil
+}
+
+func cancelSetup(handle string) error {
+	if !validSetupHandle(handle) {
+		return fmt.Errorf("invalid setup handle")
+	}
+	dir, err := getSocketDir()
+	if err != nil {
+		return fmt.Errorf("private setup runtime directory unavailable")
+	}
+	path, socket := setupPaths(dir, handle)
+	record, err := readSetupRecord(path, handle, os.Getuid())
+	if err != nil {
+		return err
+	}
+	switch record.State {
+	case "cancelled", "expired":
+		return nil
+	case "executing":
+		return fmt.Errorf("setup has committed application execution")
+	case "pending", "ready":
+	default:
+		return fmt.Errorf("invalid setup state")
+	}
+	var stat unix.Stat_t
+	if err := unix.Lstat(socket, &stat); err != nil {
+		return fmt.Errorf("setup socket unavailable")
+	}
+	if err := validateSetupStat(&stat, os.Getuid(), true); err != nil {
+		return err
+	}
+	conn, err := connectSocket(socket)
+	if err != nil {
+		// Expiration/cancellation may remove the socket between the stat and dial.
+		if record, e := readSetupRecord(path, handle, os.Getuid()); e == nil && (record.State == "cancelled" || record.State == "expired") {
+			return nil
+		}
+		return fmt.Errorf("setup socket unavailable")
+	}
+	defer conn.Close()
+	if uid, err := setupPeerUID(conn); err != nil || uid != os.Getuid() {
+		return fmt.Errorf("setup socket owner mismatch")
+	}
+	_ = conn.SetDeadline(time.Now().Add(kSocketTimeout))
+	if err := sendCommandAndMessage(conn, "setup-cancel", setupMessage{handle, 1}); err != nil {
+		return fmt.Errorf("setup cancellation request failed")
+	}
+	command, err := recvCommand(conn)
+	if err != nil || command != "setup-cancel" {
+		return fmt.Errorf("invalid setup cancellation response")
+	}
+	var response setupResponse
+	if err := recvSetupMessage(conn, &response); err != nil || response.Version != 1 {
+		return fmt.Errorf("invalid setup cancellation response")
+	}
+	if response.Error != "" {
+		return fmt.Errorf("%s", response.Error)
+	}
+	return nil
+}
+
+func handleCancelSetupCommand(handle string) (int, error) {
+	if err := cancelSetup(handle); err != nil {
+		return kExitCodeApplyOptions, err
+	}
+	return 0, nil
+}
+
+func gcSetupRecords(dir string) {
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		return
+	}
+	for _, entry := range entries {
+		handle := strings.TrimPrefix(entry.Name(), "setup-")
+		if !validSetupHandle(handle) {
+			continue
+		}
+		path, _ := setupPaths(dir, handle)
+		record, err := readSetupRecord(path, handle, os.Getuid())
+		if err == nil && (record.State == "cancelled" || record.State == "expired") && time.Now().UnixMilli() > record.Deadline+setupRecordLifetime.Milliseconds() {
+			_ = os.Remove(path)
+		}
+	}
+}
diff --git a/tsshd/setup_linux_test.go b/tsshd/setup_linux_test.go
new file mode 100644
index 00000000..5b485201
--- /dev/null
+++ b/tsshd/setup_linux_test.go
@@ -0,0 +1,286 @@
+//go:build linux
+
+package tsshd
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"os"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+func setupTestLease(t *testing.T, timeout time.Duration) *setupLease {
+	t.Helper()
+	dir, err := os.MkdirTemp("", "ts-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	t.Setenv("XDG_RUNTIME_DIR", dir)
+	l, err := newSetupLease(timeout)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(l.close)
+	return l
+}
+
+func TestAutoSetupRejectTokenUIDVersionAndState(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	for _, command := range []string{"session", "stderr", "dial", "listen", "accept", "listen-udp", "accept-udp"} {
+		if err := l.authorizeStream(command); err == nil {
+			t.Fatalf("unconfirmed %s allowed", command)
+		}
+	}
+	if err := l.execute(); err == nil {
+		t.Fatal("unconfirmed execution allowed")
+	}
+	for _, request := range []struct {
+		handle       string
+		version, uid int
+	}{
+		{strings.Repeat("0", 64), 1, l.uid}, {l.handle, 2, l.uid}, {l.handle, 1, l.uid + 1}, {"../socket", 1, l.uid},
+	} {
+		if err := l.cancel(request.handle, request.version, request.uid); err == nil {
+			t.Fatal("unauthorized cancellation allowed")
+		}
+	}
+	if err := l.confirm(strings.Repeat("0", 64), 1, time.Hour); err == nil {
+		t.Fatal("wrong token confirmed")
+	}
+	if err := l.confirm(l.handle, 2, time.Hour); err == nil {
+		t.Fatal("wrong version confirmed")
+	}
+	if err := l.confirm(l.handle, 1, time.Hour); err != nil {
+		t.Fatal(err)
+	}
+	deadline := l.deadline
+	if err := l.confirm(l.handle, 1, time.Hour); err != nil || l.deadline != deadline {
+		t.Fatal("repeat confirmation renewed lease")
+	}
+	if err := l.authorizeStream("session"); err != nil {
+		t.Fatal(err)
+	}
+	if l.state != "ready" {
+		t.Fatal("opening session committed execution")
+	}
+	if err := l.execute(); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.cancel(l.handle, 1, l.uid); err == nil {
+		t.Fatal("committed execution cancelled")
+	}
+	if err := cancelSetup(l.handle); err == nil {
+		t.Fatal("committed record cancelled")
+	}
+}
+
+func TestAutoSetupCrossInstanceAndIdempotentSocketCancel(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	other, err := newSetupLease(time.Minute)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer other.close()
+	if l.handle == other.handle {
+		t.Fatal("setup token reused")
+	}
+	if err := l.cancel(other.handle, 1, l.uid); err == nil {
+		t.Fatal("cross-instance cancellation accepted")
+	}
+	if err := l.authorizeStream("dial-udp"); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.confirm(l.handle, 1, time.Hour); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.authorizeStream("dial-udp"); err != nil || l.state != "ready" {
+		t.Fatal("provisional forwarding committed")
+	}
+	if err := cancelSetup(l.handle); err != nil {
+		t.Fatal(err)
+	}
+	l.close()
+	if err := cancelSetup(l.handle); err != nil {
+		t.Fatalf("repeat cancel after exit: %v", err)
+	}
+	if other.state != "pending" {
+		t.Fatal("unrelated instance cancelled")
+	}
+	if err := l.authorizeStream("session"); err == nil {
+		t.Fatal("cancelled instance executed")
+	}
+	if err := l.confirm(l.handle, 1, time.Hour); err == nil {
+		t.Fatal("cancelled instance reconfirmed")
+	}
+}
+
+func TestAutoSetupLeaseExpiresAndReadyExtends(t *testing.T) {
+	l := setupTestLease(t, 30*time.Millisecond)
+	l.mu.Lock()
+	l.timer.Stop()
+	expired := make(chan struct{}, 1)
+	l.onStop = func() { expired <- struct{}{} }
+	l.timer.Reset(time.Until(l.deadline))
+	l.mu.Unlock()
+	select {
+	case <-expired:
+	case <-time.After(time.Second):
+		t.Fatal("setup lease did not expire")
+	}
+	if err := l.execute(); err == nil {
+		t.Fatal("expired setup executed")
+	}
+	if err := cancelSetup(l.handle); err != nil {
+		t.Fatal(err)
+	}
+	ready, err := newSetupLease(100 * time.Millisecond)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ready.close()
+	ready.mu.Lock()
+	ready.timer.Stop()
+	ready.onStop = func() { expired <- struct{}{} }
+	ready.timer.Reset(time.Until(ready.deadline))
+	ready.mu.Unlock()
+	if err := ready.confirm(ready.handle, 1, 300*time.Millisecond); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-expired:
+		t.Fatal("ready expired at original setup deadline")
+	case <-time.After(150 * time.Millisecond):
+	}
+	if err := ready.cancel(ready.handle, 1, ready.uid); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestAutoSetupCancellationExecutionAtomic(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	if err := l.confirm(l.handle, 1, time.Hour); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	var execution, cancellation error
+	wg.Add(2)
+	go func() { defer wg.Done(); execution = l.execute() }()
+	go func() { defer wg.Done(); cancellation = l.cancel(l.handle, 1, l.uid) }()
+	wg.Wait()
+	if (execution == nil) == (cancellation == nil) {
+		t.Fatalf("must have exactly one winner: execution=%v cancel=%v", execution, cancellation)
+	}
+}
+
+func TestAutoSetupActivityCannotExtendPendingLease(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	deadline := l.deadline
+	l.activity(time.Hour)
+	if l.deadline != deadline {
+		t.Fatal("heartbeat extended an uncommitted setup lease")
+	}
+	if err := l.confirm(l.handle, 1, time.Minute); err != nil {
+		t.Fatal(err)
+	}
+	deadline = l.deadline
+	l.activity(time.Hour)
+	if !l.deadline.After(deadline) {
+		t.Fatal("confirmed intermediate hop did not renew its idle lifetime")
+	}
+}
+
+func TestAutoSetupRecordOwnershipAndSymlink(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	path, socket := setupPaths(l.dir, l.handle)
+	for _, stat := range []unix.Stat_t{
+		{Uid: uint32(l.uid + 1), Mode: unix.S_IFREG | 0600},
+		{Uid: uint32(l.uid), Mode: unix.S_IFREG | 0644},
+		{Uid: uint32(l.uid), Mode: unix.S_IFLNK | 0600},
+	} {
+		if err := validateSetupStat(&stat, l.uid, false); err == nil {
+			t.Fatal("invalid stat accepted")
+		}
+	}
+	if _, err := readSetupRecord(path, l.handle, l.uid+1); err == nil {
+		t.Fatal("wrong owner accepted")
+	}
+	if err := os.Chmod(socket, 0666); err != nil {
+		t.Fatal(err)
+	}
+	if err := cancelSetup(l.handle); err == nil {
+		t.Fatal("public socket accepted")
+	}
+	if err := os.Chmod(socket, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(socket, path); err != nil {
+		t.Fatal(err)
+	}
+	if err := cancelSetup(l.handle); err == nil {
+		t.Fatal("symlink record accepted")
+	}
+}
+
+func TestAutoSetupSocketRejectsCrossInstanceToken(t *testing.T) {
+	l := setupTestLease(t, time.Minute)
+	_, socket := setupPaths(l.dir, l.handle)
+	conn, err := net.Dial("unix", socket)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(time.Second))
+	if err := sendCommandAndMessage(conn, "setup-cancel", setupMessage{strings.Repeat("0", 64), 1}); err != nil {
+		t.Fatal(err)
+	}
+	cmd, err := recvCommand(conn)
+	if err != nil || cmd != "setup-cancel" {
+		t.Fatal("missing rejection response")
+	}
+	var response setupResponse
+	if err := recvSetupMessage(conn, &response); err != nil || response.Error == "" {
+		t.Fatal("wrong token not rejected")
+	}
+	if l.state != "pending" {
+		t.Fatal("wrong token changed state")
+	}
+}
+
+func TestAutoSetupMessageBoundAndTokenRedaction(t *testing.T) {
+	var size [4]byte
+	binary.BigEndian.PutUint32(size[:], 1<<30)
+	if err := recvSetupMessage(bytes.NewReader(size[:]), &setupMessage{}); err == nil {
+		t.Fatal("oversized message accepted")
+	}
+	secret := strings.Repeat("a", 64)
+	data := []byte(`{"Handle":"` + secret + `",`)
+	binary.BigEndian.PutUint32(size[:], uint32(len(data)))
+	if err := recvSetupMessage(bytes.NewReader(append(size[:], data...)), &setupMessage{}); err == nil || strings.Contains(err.Error(), secret) {
+		t.Fatal("malformed setup token disclosed")
+	}
+}
+
+func TestAutoSetupCLIValidation(t *testing.T) {
+	saved := os.Args
+	defer func() { os.Args = saved }()
+	for _, timeout := range []string{"0", "-1", "3601", "1.5", "bogus"} {
+		os.Args = []string{"tsshd", "--setup-timeout", timeout}
+		if parseTsshdArgs().SetupError == nil {
+			t.Fatalf("invalid lease %s accepted", timeout)
+		}
+	}
+	os.Args = []string{"tsshd", "--setup-timeout", "3600"}
+	if args := parseTsshdArgs(); args.SetupError != nil || args.SetupTimeout != time.Hour {
+		t.Fatal("valid lease rejected")
+	}
+}
diff --git a/tsshd/setup_other.go b/tsshd/setup_other.go
