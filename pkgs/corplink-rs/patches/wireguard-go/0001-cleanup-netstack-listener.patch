diff --git a/libwg/socks5_lifecycle_test.go b/libwg/socks5_lifecycle_test.go
new file mode 100644
index 0000000..29a03b8
--- /dev/null
+++ b/libwg/socks5_lifecycle_test.go
@@ -0,0 +1,76 @@
+package main
+
+import (
+	"net"
+	"testing"
+	"time"
+
+	"golang.zx2c4.com/wireguard/device"
+)
+
+func TestSocks5ListenerCanStopAndRestartOnSamePort(t *testing.T) {
+	probe, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := probe.Addr().String()
+	if err := probe.Close(); err != nil {
+		t.Fatal(err)
+	}
+
+	for i := 0; i < 3; i++ {
+		server, err := startSocks5(addr, "", "", nil, device.NewLogger(0, "test "))
+		if err != nil {
+			t.Fatalf("start %d: %v", i, err)
+		}
+		client, err := net.Dial("tcp", addr)
+		if err != nil {
+			server.Close()
+			t.Fatalf("dial %d: %v", i, err)
+		}
+		waitForConnections(t, server.listener, 1)
+		// Keep the accepted SOCKS connection idle so shutdown must actively
+		// close it rather than relying on handler completion.
+		server.Close()
+		_ = client.SetReadDeadline(time.Now().Add(time.Second))
+		if _, err := client.Read(make([]byte, 1)); err == nil {
+			t.Fatalf("accepted connection remained open after stop %d", i)
+		}
+		_ = client.Close()
+	}
+}
+
+func TestSocks5StartFailureLeavesExistingListenerUsable(t *testing.T) {
+	server, err := startSocks5("127.0.0.1:0", "", "", nil, device.NewLogger(0, "test "))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	if _, err := startSocks5(server.listener.Addr().String(), "", "", nil, device.NewLogger(0, "test ")); err == nil {
+		t.Fatal("second listener unexpectedly bound an occupied address")
+	}
+	client, err := net.Dial("tcp", server.listener.Addr().String())
+	if err != nil {
+		t.Fatalf("existing listener was affected by failed start: %v", err)
+	}
+	_ = client.Close()
+}
+
+func waitForConnections(t *testing.T, listener *trackedListener, want int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		listener.mu.Lock()
+		got := len(listener.conns)
+		listener.mu.Unlock()
+		if got == want {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	listener.mu.Lock()
+	got := len(listener.conns)
+	listener.mu.Unlock()
+	t.Fatalf("listener accepted %d connections, want %d", got, want)
+}
