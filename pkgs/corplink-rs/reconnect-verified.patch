+async fn start_tunnel(
+    conf: &WgConf,
+    name: &str,
+    socks5_listen: Option<&str>,
+    socks5_username: &str,
+    socks5_password: &str,
+    with_wg_log: bool,
+    uapi: &mut wg::UAPIClient,
+) -> Result<()> {
+    let started = if let Some(listen) = socks5_listen {
+        wg::start_wg_go_netstack(conf, listen, socks5_username, socks5_password, with_wg_log)
+    } else {
+        wg::start_wg_go(name, conf.protocol, with_wg_log)
+    };
+    if let Err(err) = started {
+        wg::stop_wg_go();
+        return Err(err);
+    }
+    let configured = if socks5_listen.is_some() {
+        uapi.config_wg_netstack(conf).await
+    } else {
+        uapi.config_wg(conf).await
+    };
+    if let Err(err) = configured {
+        wg::stop_wg_go();
+        return Err(err);
+    }
+    Ok(())
 }
 
