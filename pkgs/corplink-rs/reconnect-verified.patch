+
+fn initial_handshake_expired(
+    last_handshake: i64,
+    now: tokio::time::Instant,
+    deadline: tokio::time::Instant,
+) -> bool {
+    last_handshake == 0 && now >= deadline
+}
+
+pub fn retry_delay(attempt: usize) -> Duration {
+    let seconds = [5u64, 15, 30, 60][attempt.min(3)];
+    let jitter_ms = (rand::random::<u64>() % 2001) as i64 - 1000;
+    Duration::from_millis((seconds as i64 * 1000 + jitter_ms).max(0) as u64)
+}
+
+#[cfg(test)]
+mod reconnect_tests {
+    use super::{initial_handshake_expired, retry_delay};
+    use std::time::Duration;
+
+    #[test]
+    fn reconnect_delay_uses_bounded_backoff() {
+        let bases = [5, 15, 30, 60, 60, 60];
+        for (attempt, base) in bases.into_iter().enumerate() {
+            let delay = retry_delay(attempt);
+            assert!(delay >= Duration::from_millis(base * 1000 - 1000));
+            assert!(delay <= Duration::from_millis(base * 1000 + 1000));
+        }
+    }
+
+    #[test]
+    fn only_zero_handshake_past_deadline_expires_initial_connection() {
+        let start = tokio::time::Instant::now();
+        let deadline = start + Duration::from_secs(300);
+        assert!(!initial_handshake_expired(
+            0,
+            deadline - Duration::from_secs(1),
+            deadline
+        ));
+        assert!(initial_handshake_expired(0, deadline, deadline));
+        assert!(!initial_handshake_expired(10, deadline, deadline));
+    }
+}
