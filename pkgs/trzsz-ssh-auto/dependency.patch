new file mode 100644
index 00000000..a8e3515b
--- /dev/null
+++ b/tsshd/auto_client.go
@@ -0,0 +1,182 @@
+package tsshd
+
+import (
+	"context"
+	"crypto/aes"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"sync/atomic"
+	"time"
+)
+
+// ConnectionTimeout identifies only a deadline during initial transport setup.
+// Application, remote administrative, and reconnection errors do not use it.
+type ConnectionTimeout struct{ Cause error }
+
+func (e *ConnectionTimeout) Error() string { return "UDP establishment timeout: " + e.Cause.Error() }
+func (e *ConnectionTimeout) Unwrap() error { return e.Cause }
+
+func connectionError(err error) error {
+	var remote *Error
+	if errors.As(err, &remote) {
+		return err
+	}
+	var timeout net.Error
+	if errors.Is(err, context.DeadlineExceeded) || errors.Is(err, os.ErrDeadlineExceeded) ||
+		(errors.As(err, &timeout) && timeout.Timeout()) {
+		return &ConnectionTimeout{Cause: err}
+	}
+	return err
+}
+
+// ValidateAutoOffer rejects incompatible or malformed offers before network I/O.
+func ValidateAutoOffer(info *ServerInfo) error {
+	if info == nil || info.SetupVersion != 1 || info.ProtoVer != kTsshdProtocol ||
+		info.Mode != kUdpModeKCP || info.ProxyMode != "" || info.Port < 1 || info.Port > 65535 || info.ServerID == 0 {
+		return fmt.Errorf("incompatible automatic KCP offer")
+	}
+	if net.ParseIP(info.BindAddress) == nil {
+		return fmt.Errorf("invalid automatic KCP bind address")
+	}
+	handle, err := hex.DecodeString(info.SetupHandle)
+	if err != nil || len(handle) != 32 || hex.EncodeToString(handle) != info.SetupHandle {
+		return fmt.Errorf("invalid automatic KCP setup handle")
+	}
+	key, err := hex.DecodeString(info.ProxyKey)
+	if err != nil {
+		return fmt.Errorf("invalid automatic KCP proxy key")
+	}
+	if _, err := aes.NewCipher(key); err != nil {
+		return fmt.Errorf("invalid automatic KCP proxy key length")
+	}
+	for _, value := range []string{info.Pass, info.Salt} {
+		decoded, err := hex.DecodeString(value)
+		if err != nil || len(decoded) != 48 {
+			return fmt.Errorf("invalid automatic KCP key material")
+		}
+	}
+	if info.MTU < 576 || info.MTU > 1500 {
+		return fmt.Errorf("invalid automatic KCP MTU")
+	}
+	return nil
+}
+
+type setupCommitMessage struct {
+	Handle  string
+	Version int
+}
+
+type setupCommitResponse struct {
+	Version int
+	Error   string
+}
+
+var barrierSequence atomic.Int64
+
+// HeartbeatBarrier confirms all preceding settings on the same ordered bus.
+// KCPProxyMTU matches the locked upstream AES-GCM/FEC 1+1 OOB layout.
+// Every child KCP packet must fit entirely in its parent's real UDP datagram.
+func KCPProxyMTU(mtu uint16) (uint16, error) {
+	const overhead = 12 + 16 + 8 + 4 + kUdpForwardChannelIdSize
+	if mtu < 576+overhead || mtu > 1500 {
+		return 0, fmt.Errorf("KCP proxy datagram budget is too small or unsupported")
+	}
+	return mtu - overhead, nil
+}
+
+func (c *SshUdpClient) HeartbeatBarrier(timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	token := barrierSequence.Add(-1)
+	ack := make(chan struct{}, 1)
+	c.barrierMutex.Lock()
+	if c.barrierAcks == nil {
+		c.barrierAcks = make(map[int64]chan struct{})
+	}
+	c.barrierAcks[token] = ack
+	c.barrierMutex.Unlock()
+	defer func() {
+		c.barrierMutex.Lock()
+		delete(c.barrierAcks, token)
+		c.barrierMutex.Unlock()
+	}()
+	if err := c.sendBoundedBusMessage("alive", aliveMessage{Time: token}, timeout); err != nil {
+		return err
+	}
+	timer := time.NewTimer(time.Until(deadline))
+	defer timer.Stop()
+	select {
+	case <-ack:
+		return nil
+	case <-c.busClosed:
+		return net.ErrClosed
+	case <-timer.C:
+		return fmt.Errorf("ordered heartbeat barrier: %w", context.DeadlineExceeded)
+	}
+}
+
+func (c *SshUdpClient) sendBoundedBusMessage(command string, message any, timeout time.Duration) error {
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	locked := make(chan struct{})
+	go func() {
+		c.busMutex.Lock()
+		select {
+		case locked <- struct{}{}:
+		case <-ctx.Done():
+			c.busMutex.Unlock()
+		}
+	}()
+	select {
+	case <-locked:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	defer c.busMutex.Unlock()
+	if c.busStream == nil || c.IsClosed() {
+		return net.ErrClosed
+	}
+	deadline, _ := ctx.Deadline()
+	if err := c.busStream.SetWriteDeadline(deadline); err != nil {
+		return err
+	}
+	defer c.busStream.SetWriteDeadline(time.Time{})
+	return sendCommandAndMessage(c.busStream, command, message)
+}
+
+// CommitSetup extends the setup lease after the complete chain is ready.
+// Its errors are intentionally not ConnectionTimeout: rollback may clean up,
+// but it must not downgrade after a commit acknowledgement becomes ambiguous.
+func (c *SshUdpClient) CommitSetup(handle string, timeout time.Duration) error {
+	deadline := time.Now().Add(timeout)
+	if c.setupAck == nil {
+		return fmt.Errorf("not a transactional UDP client")
+	}
+	if err := c.sendBoundedBusMessage("setup-commit", setupCommitMessage{handle, 1}, timeout); err != nil {
+		return err
+	}
+	timer := time.NewTimer(time.Until(deadline))
+	defer timer.Stop()
+	select {
+	case resp := <-c.setupAck:
+		if resp.Version != 1 || resp.Error != "" {
+			return fmt.Errorf("setup commit rejected: version=%d error=%s", resp.Version, resp.Error)
+		}
+		c.activeChecker.onTimeout(c.tryToReconnect)
+		c.setupCommitted.Store(true)
+		return nil
+	case <-c.busClosed:
+		return net.ErrClosed
+	case <-timer.C:
+		return fmt.Errorf("setup commit acknowledgement: %w", context.DeadlineExceeded)
+	}
+}
+
+func (c *SshUdpClient) establishmentTimeout() time.Duration {
+	if c.establishmentDeadline.IsZero() {
+		return c.connectTimeout
+	}
+	return max(time.Until(c.establishmentDeadline), time.Nanosecond)
+}
