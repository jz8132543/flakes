new file mode 100644
index 00000000..aec02b4c
--- /dev/null
+++ b/tsshd/auto_client_test.go
@@ -0,0 +1,115 @@
+package tsshd
+
+import (
+	"context"
+	"crypto/aes"
+	"crypto/cipher"
+	"errors"
+	"fmt"
+	"net"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/trzsz/kcp-go/v5"
+)
+
+func testAutoOffer() *ServerInfo {
+	return &ServerInfo{ServerVer: "0.1.10", ProtoVer: 1, Mode: "KCP", Port: 61001, ServerID: 1, BindAddress: "127.0.0.1", SetupVersion: 1,
+		SetupHandle: strings.Repeat("a", 64), ProxyKey: strings.Repeat("b", 64), Pass: strings.Repeat("c", 96), Salt: strings.Repeat("d", 96), MTU: 1350}
+}
+
+func TestAutoOfferValidation(t *testing.T) {
+	if err := ValidateAutoOffer(testAutoOffer()); err != nil {
+		t.Fatal(err)
+	}
+	for _, mutate := range []func(*ServerInfo){
+		func(s *ServerInfo) { s.ProtoVer++ }, func(s *ServerInfo) { s.SetupVersion++ }, func(s *ServerInfo) { s.Port = 0 },
+		func(s *ServerInfo) { s.BindAddress = "host.test" }, func(s *ServerInfo) { s.SetupHandle = "../token" },
+		func(s *ServerInfo) { s.ProxyKey = "bad" }, func(s *ServerInfo) { s.Pass = "bad" }, func(s *ServerInfo) { s.MTU = 0 },
+		func(s *ServerInfo) { s.ProxyMode = "TCP" }, func(s *ServerInfo) { s.ServerID = 0 },
+	} {
+		s := testAutoOffer()
+		mutate(s)
+		if err := ValidateAutoOffer(s); err == nil {
+			t.Fatal("invalid offer accepted")
+		}
+	}
+}
+
+func TestAutoTypedTimeoutPreservesCause(t *testing.T) {
+	cause := fmt.Errorf("wrapped: %w", context.DeadlineExceeded)
+	var timeout *ConnectionTimeout
+	if err := connectionError(cause); !errors.As(err, &timeout) || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("lost cause: %v", err)
+	}
+	if err := connectionError(errors.New("timeout")); errors.As(err, &timeout) {
+		t.Fatal("matched timeout text")
+	}
+	remote := &Error{Msg: "remote timeout"}
+	if err := connectionError(fmt.Errorf("remote: %w", remote)); errors.As(err, &timeout) {
+		t.Fatal("remote error downgraded")
+	}
+}
+
+type autoTestStream struct{ net.Conn }
+
+func (s autoTestStream) CloseRead() error  { return s.Close() }
+func (s autoTestStream) CloseWrite() error { return s.Close() }
+
+func TestAutoBoundedBusWriteAndLock(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	c := &SshUdpClient{busStream: autoTestStream{a}}
+	start := time.Now()
+	if err := c.sendBoundedBusMessage("alive", aliveMessage{}, 20*time.Millisecond); err == nil {
+		t.Fatal("unread write did not time out")
+	}
+	if time.Since(start) > time.Second {
+		t.Fatal("unbounded write")
+	}
+	c.busMutex.Lock()
+	start = time.Now()
+	if err := c.sendBoundedBusMessage("alive", aliveMessage{}, 20*time.Millisecond); err == nil {
+		t.Fatal("busy mutex did not time out")
+	}
+	c.busMutex.Unlock()
+	if time.Since(start) > time.Second {
+		t.Fatal("unbounded mutex acquisition")
+	}
+}
+
+func TestAutoKCPProxyMTUMatchesLockedEngine(t *testing.T) {
+	packet, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer packet.Close()
+	block, err := aes.NewCipher(make([]byte, 32))
+	if err != nil {
+		t.Fatal(err)
+	}
+	aead, err := cipher.NewGCM(block)
+	if err != nil {
+		t.Fatal(err)
+	}
+	conn, err := kcp.NewConn2(&net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9}, kcp.NewAEADCrypt(aead), 1, 1, packet)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer conn.Close()
+	for _, mtu := range []uint16{624, 1200, 1350, 1500} {
+		if !conn.SetMtu(int(mtu)) {
+			t.Fatal("upstream rejected MTU")
+		}
+		want := uint16(conn.GetOOBMaxSize()) - kUdpForwardChannelIdSize
+		got, err := KCPProxyMTU(mtu)
+		if err != nil || got != want {
+			t.Fatalf("MTU %d: got %d, want %d: %v", mtu, got, want, err)
+		}
+	}
+	if _, err := KCPProxyMTU(576); err == nil {
+		t.Fatal("accepted undersized child datagram")
+	}
+}
