+package tssh
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/trzsz/go-arg"
+	"github.com/trzsz/tsshd/tsshd"
+)
+
+type autoTestClient struct {
+	SshClient
+	version string
+	name    string
+	events  *[]string
+}
+
+func (c *autoTestClient) ServerVersion() []byte { return []byte(c.version) }
+func (c *autoTestClient) Close() error {
+	*c.events = append(*c.events, "close-"+c.name)
+	return nil
+}
+
+func validTestAutoOffer() *tsshd.ServerInfo {
+	return &tsshd.ServerInfo{ServerVer: "0.1.10", ProtoVer: 1, Mode: "KCP", Port: 61001, ServerID: 1,
+		BindAddress: "127.0.0.1", SetupVersion: 1, SetupHandle: strings.Repeat("a", 64),
+		ProxyKey: strings.Repeat("b", 64), Pass: strings.Repeat("c", 96), Salt: strings.Repeat("d", 96), MTU: 1350}
+}
+
+func TestAutoCapabilityExactAuthenticatedToken(t *testing.T) {
+	for _, test := range []struct {
+		version string
+		want    bool
+	}{
+		{"SSH-2.0-OpenSSH_10.6 " + autoCapability, true},
+		{"SSH-2.0-OpenSSH_10.6 other " + autoCapability + " extra", true},
+		{"SSH-2.0-OpenSSH_10.6 " + autoCapability + "-extra", false},
+		{"SSH-2.0-OpenSSH_10.6 prefix-" + autoCapability, false},
+		{"SSH-2.0-OpenSSH_10.6", false},
+	} {
+		if got := hasAutoCapability(&autoTestClient{version: test.version}); got != test.want {
+			t.Fatalf("%q: %v", test.version, got)
+		}
+	}
+}
+
+func TestAutoTransactionOrderingAndFailureIsolation(t *testing.T) {
+	for _, phase := range []string{"success", "unmarked", "authenticate", "prepare", "establish-timeout", "establish-fatal", "barrier", "commit"} {
+		for failure := 0; failure < 3; failure++ {
+			t.Run(fmt.Sprintf("%s/%d", phase, failure), func(t *testing.T) {
+				var events []string
+				hops := make([]*autoHop, 3)
+				for i := range hops {
+					hops[i] = &autoHop{}
+				}
+				step := func(name string, i int) error {
+					events = append(events, fmt.Sprintf("%s-%d", name, i))
+					if name == phase && i == failure {
+						return errors.New("fatal")
+					}
+					return nil
+				}
+				ops := autoOperations{
+					authenticate: func(i int) (SshClient, error) {
+						if err := step("authenticate", i); err != nil {
+							return nil, err
+						}
+						version := "SSH-2.0-test " + autoCapability
+						if phase == "unmarked" && i == failure {
+							version = "SSH-2.0-native"
+						}
+						return &autoTestClient{version: version, name: fmt.Sprintf("N%d", i), events: &events}, nil
+					},
+					prepare: func(i int) (*tsshd.ServerInfo, error) { return validTestAutoOffer(), step("prepare", i) },
+					establish: func(i int) (SshClient, error) {
+						events = append(events, fmt.Sprintf("establish-%d", i))
+						if i == failure {
+							if phase == "establish-timeout" {
+								return nil, fmt.Errorf("wrapped: %w", &tsshd.ConnectionTimeout{Cause: context.DeadlineExceeded})
+							}
+							if phase == "establish-fatal" {
+								return nil, errors.New("timeout text is not a classified timeout")
+							}
+						}
+						return &autoTestClient{name: fmt.Sprintf("U%d", i), events: &events}, nil
+					},
+					barrier: func(i int) error { return step("barrier", i) },
+					commit:  func(i int) error { return step("commit", i) },
+					cancel:  func(i int) error { return step("cancel", i) },
+				}
+				udp, err := selectAutoChain(hops, ops)
+				if phase == "success" {
+					if !udp || err != nil {
+						t.Fatalf("success: %v %v", udp, err)
+					}
+					want := []string{"authenticate-0", "authenticate-1", "authenticate-2", "prepare-0", "prepare-1", "prepare-2", "establish-0", "establish-1", "establish-2", "barrier-0", "barrier-1", "barrier-2", "commit-0", "commit-1", "commit-2", "close-N2", "close-N1", "close-N0"}
+					if !reflect.DeepEqual(events, want) {
+						t.Fatalf("wrong ordering: %v", events)
+					}
+				} else if phase == "unmarked" {
+					if udp || err != nil || len(events) != 3 {
+						t.Fatalf("unmarked must retain native chain without offers: %v %v %v", udp, err, events)
+					}
+				} else if phase == "establish-timeout" {
+					if udp || err != nil {
+						t.Fatalf("classified timeout did not fall back: %v %v", udp, err)
+					}
+					for _, event := range events {
+						if strings.HasPrefix(event, "close-N") || strings.HasPrefix(event, "commit-") {
+							t.Fatalf("fallback lost native ownership: %v", events)
+						}
+					}
+				} else if udp || err == nil {
+					t.Fatalf("fatal failure downgraded: %v %v", udp, err)
+				}
+				var cancellations []string
+				for _, event := range events {
+					if strings.HasPrefix(event, "cancel-") {
+						cancellations = append(cancellations, event)
+					}
+				}
+				if len(cancellations) > 1 {
+					for i := 1; i < len(cancellations); i++ {
+						if cancellations[i] >= cancellations[i-1] {
+							t.Fatalf("cleanup not reverse: %v", events)
+						}
+					}
+				}
+			})
+		}
+	}
+}
