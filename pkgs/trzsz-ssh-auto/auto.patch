+func TestAutoExplicitTransportOverrides(t *testing.T) {
+	for _, args := range []*sshArgs{
+		{AutoTransport: true, TCP: true}, {AutoTransport: true, KCP: true}, {AutoTransport: true, QUIC: true}, {AutoTransport: true, UDP: true},
+		{AutoTransport: true, Option: sshOption{options: map[string][]string{"udpmode": {"KCP"}}}},
+	} {
+		if wantsAutoTransport(args) {
+			t.Fatal("explicit transport did not override auto")
+		}
+	}
+}
+
+func TestAutoApplicationArgvDoesNotParseRemoteOptions(t *testing.T) {
+	for _, argv := range [][]string{
+		{"--auto-transport", "-Tp2222", "-i", "/key with space", "host", "sh", "-v", "--debug"},
+		{"-o", "ProxyCommand=/native/ssh -W %h:%p jump", "host", "sh", "-v", "--debug"},
+		{"--", "host", "sh", "-v", "--debug"},
+	} {
+		var args sshArgs
+		parser, err := arg.NewParser(arg.Config{}, &args)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := parser.Parse(applicationArgv(argv)); err != nil {
+			t.Fatal(err)
+		}
+		if args.Destination != "host" || args.Command != "sh" || args.Debug || !reflect.DeepEqual(args.Argument, []string{"-v", "--debug"}) {
+			t.Fatalf("remote arguments were reinterpreted: %+v", args)
+		}
+	}
+}
