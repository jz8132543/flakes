+package tssh
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/trzsz/shellescape"
+	"github.com/trzsz/tsshd/tsshd"
+)
+
+const autoCapability = "tsshd-kcp-auto-v1"
+
+func applicationArgv(argv []string) []string {
+	values := make(map[string]bool)
+	argsType := reflect.TypeOf(sshArgs{})
+	for i := 0; i < argsType.NumField(); i++ {
+		field := argsType.Field(i)
+		for _, name := range strings.Split(field.Tag.Get("arg"), ",") {
+			if strings.HasPrefix(name, "-") && name != "--" {
+				values[name] = field.Type.Kind() != reflect.Bool
+			}
+		}
+	}
+	for i := 0; i < len(argv); i++ {
+		word := argv[i]
+		if word == "--" {
+			return argv
+		}
+		if !strings.HasPrefix(word, "-") || word == "-" {
+			result := append([]string(nil), argv[:i+1]...)
+			return append(append(result, "--"), argv[i+1:]...)
+		}
+		if strings.HasPrefix(word, "--") {
+			name, _, attached := strings.Cut(word, "=")
+			value, known := values[name]
+			if !known {
+				return argv
+			}
+			if value && !attached {
+				i++
+			}
+			continue
+		}
+		for j := 1; j < len(word); j++ {
+			value, known := values["-"+word[j:j+1]]
+			if !known {
+				return argv
+			}
+			if value {
+				if j+1 == len(word) {
+					i++
+				}
+				break
+			}
+		}
+	}
+	return argv
+}
+
+func wantsAutoTransport(args *sshArgs) bool {
+	if args.TCP || args.KCP || args.QUIC || args.UDP || args.Attach || args.Option.get("UdpMode") != "" ||
+		(userConfig != nil && getExConfig(args, "UdpMode") != "") {
+		return false
+	}
+	return args.AutoTransport || (userConfig != nil && strings.EqualFold(getExOptionConfig(args, "AutoTransport"), "yes")) ||
+		strings.EqualFold(args.Option.get("AutoTransport"), "yes")
+}
+
+func reliableIO(args *sshArgs) bool {
+	return args.ReliableIO || strings.EqualFold(args.Option.get("ReliableIO"), "yes") ||
+		(userConfig != nil && strings.EqualFold(getExOptionConfig(args, "ReliableIO"), "yes"))
+}
+
+func hasAutoCapability(client SshClient) bool {
+	metadata, ok := client.(interface{ ServerVersion() []byte })
+	if !ok {
+		return false
+	}
+	for _, token := range strings.Fields(string(metadata.ServerVersion())) {
+		if token == autoCapability {
+			return true
+		}
+	}
+	return false
+}
+
+type autoHop struct {
+	param    *sshParam
+	native   SshClient
+	udp      SshClient
+	offer    *tsshd.ServerInfo
+	endpoint string
+	budget   time.Duration
+	opaque   bool
+	path     string
+	quit     atomic.Pointer[error]
+}
+
+// Operations are separated from the transaction so failure ordering and the
+// no-application-before-commit boundary can be tested without remote servers.
+type autoOperations struct {
+	authenticate func(int) (SshClient, error)
+	prepare      func(int) (*tsshd.ServerInfo, error)
+	establish    func(int) (SshClient, error)
+	barrier      func(int) error
+	commit       func(int) error
+	cancel       func(int) error
+}
+
+func selectAutoChain(hops []*autoHop, ops autoOperations) (bool, error) {
+	closeNative := func() {
+		for i := len(hops) - 1; i >= 0; i-- {
+			if hops[i].native != nil {
+				_ = hops[i].native.Close()
+			}
+		}
+	}
+	rollback := func() {
+		for i := len(hops) - 1; i >= 0; i-- {
+			if hops[i].offer != nil {
+				if err := ops.cancel(i); err != nil {
+					warning("automatic KCP cleanup failed at hop %d; setup lease remains the cleanup bound: %v", i+1, err)
+				}
+			}
+			if hops[i].udp != nil {
+				_ = hops[i].udp.Close()
+			}
+		}
+	}
+	for i, hop := range hops {
+		client, err := ops.authenticate(i)
+		if err != nil {
+			closeNative()
+			return false, err
+		}
+		hop.native = client
+	}
+	for _, hop := range hops {
+		if hop.opaque || !hasAutoCapability(hop.native) {
+			return false, nil
+		}
+	}
+	for i, hop := range hops {
+		info, err := ops.prepare(i)
+		// Retain even malformed offers with a valid handle for owned cleanup.
+		hop.offer = info
+		if err == nil {
+			err = tsshd.ValidateAutoOffer(info)
+		}
+		if err != nil {
+			rollback()
+			closeNative()
+			return false, fmt.Errorf("prepare hop %d: %w", i+1, err)
+		}
+	}
+	for i, hop := range hops {
+		client, err := ops.establish(i)
+		hop.udp = client
+		if err != nil {
+			rollback()
+			var timeout *tsshd.ConnectionTimeout
+			if errors.As(err, &timeout) {
+				return false, nil
+			}
+			closeNative()
+			return false, fmt.Errorf("establish hop %d: %w", i+1, err)
+		}
+	}
+	for i := range hops {
+		if err := ops.barrier(i); err != nil {
+			rollback()
+			closeNative()
+			return false, fmt.Errorf("setup I/O barrier hop %d: %w", i+1, err)
+		}
+	}
+	for i := range hops {
+		if err := ops.commit(i); err != nil {
+			rollback()
+			closeNative()
+			return false, fmt.Errorf("setup commit hop %d: %w", i+1, err)
+		}
+	}
+	closeNative()
+	return true, nil
+}
+
+func cloneAutoArgs(args *sshArgs, destination string, target bool) *sshArgs {
+	copy := *args
+	copy.Destination, copy.originalDest, copy.canonicalDest = destination, "", ""
+	copy.Option.options = make(map[string][]string)
+	for key, values := range args.Option.options {
+		if target || (key != "hostname" && key != "user" && key != "port" && key != "proxyjump" && key != "proxycommand") {
+			copy.Option.options[key] = append([]string(nil), values...)
+		}
+	}
+	if !target {
+		copy.ProxyJump, copy.LoginName, copy.Port = "", "", 0
+		copy.Command, copy.Argument = "", nil
+	}
+	return &copy
+}
+
+func knownAutoCommand(param *sshParam, option string, expectedArgs int) bool {
+	binary := getExOptionConfig(param.args, option)
+	if !filepath.IsAbs(binary) || param.command == "" {
+		return false
+	}
+	argv, err := splitCommandLine(param.command)
+	return err == nil && len(argv) == expectedArgs && argv[0] == binary
+}
+
+func buildAutoChain(target *sshParam) ([]*autoHop, error) {
+	var hops []*autoHop
+	visiting := make(map[string]bool)
+	var visit func(*sshParam) error
+	visit = func(param *sshParam) error {
+		identity := param.args.originalDest
+		if visiting[identity] || len(hops) >= 32 {
+			return fmt.Errorf("cyclic or excessive automatic jump chain")
+		}
+		visiting[identity] = true
+		defer delete(visiting, identity)
+		// Only the configured HM router is interpreted, and only its destination.
+		if knownAutoCommand(param, "AutoTransportJumpRouter", 3) {
+			argv, _ := splitCommandLine(param.command)
+			if argv[1] != "%h" || argv[2] != "%p" {
+				return fmt.Errorf("unsupported configured jump router arguments")
+			}
+			user, host, port := parseDestination(identity)
+			if strings.Count(host, "-") != 1 || strings.Contains(host, ".") {
+				return fmt.Errorf("invalid automatic jump destination")
+			}
+			parts := strings.SplitN(host, "-", 2)
+			if parts[0] == "" || parts[1] == "" {
+				return fmt.Errorf("empty automatic jump destination component")
+			}
+			destination := parts[0]
+			if user != "" {
+				destination = user + "@" + destination
+			}
+			if port != "" {
+				destination += ":" + port
+			}
+			replacement, err := getSshParam(cloneAutoArgs(param.args, destination, true), false)
+			if err != nil {
+				return err
+			}
+			replacement.proxies = []string{parts[1]}
+			replacement.command = ""
+			return visit(replacement)
+		}
+		for _, name := range param.proxies {
+			proxy, err := getSshParam(cloneAutoArgs(target.args, name, false), true)
+			if err != nil {
+				return err
+			}
+			if err := visit(proxy); err != nil {
+				return err
+			}
+		}
+		copy := *param
+		copy.proxies = append([]string(nil), param.proxies...)
+		copy.autoTransport, copy.udpMode = true, kUdpModeNo
+		copy.proxy, copy.muxMasterPath = nil, ""
+		budget := getUdpTimeoutConfig(copy.args, "AutoTransportTimeout", 10*time.Second)
+		path := getTsshdPath(copy.args)
+		if path == "tsshd" {
+			path = "/run/current-system/sw/bin/tsshd"
+		}
+		hop := &autoHop{param: &copy, budget: budget, path: path,
+			opaque: copy.user == "nix-ssh" || target.args.Subsystem || target.args.StdioForward != ""}
+		if copy.command != "" {
+			if knownAutoCommand(&copy, "AutoTransportResolver", 5) {
+				argv, _ := splitCommandLine(copy.command)
+				if argv[1] != "-domains" || argv[2] != getExOptionConfig(copy.args, "AutoTransportDomains") || argv[3] != "%h" || argv[4] != "%p" {
+					hop.opaque = true
+				} else {
+					copy.command = "" // exact configured resolver, never an opaque proxy
+				}
+			} else {
+				hop.opaque = true
+			}
+		}
+		hops = append(hops, hop)
+		return nil
+	}
+	if err := visit(target); err != nil {
+		return nil, err
+	}
+	if len(hops) == 0 {
+		return nil, fmt.Errorf("empty automatic jump chain")
+	}
+	return hops, nil
+}
+
+func resolveAutoOrigin(param *sshParam) error {
+	binary := getExOptionConfig(param.args, "AutoTransportResolver")
+	if binary == "" {
+		return nil
+	}
+	if !filepath.IsAbs(binary) {
+		return fmt.Errorf("AutoTransportResolver must be an absolute configured binary")
+	}
+	argv := []string{"--resolve"}
+	_, ipv4, ipv6 := getNetworkAddressFamily(param.args)
+	if ipv4 {
+		argv = append(argv, "-4")
+	}
+	if ipv6 {
+		argv = append(argv, "-6")
+	}
+	domains := getExOptionConfig(param.args, "AutoTransportDomains")
+	if domains != "" {
+		argv = append(argv, "-domains", domains)
+	}
+	argv = append(argv, param.host, param.port)
+	ctx, cancel := context.WithTimeout(context.Background(), getConnectTimeout(param.args))
+	defer cancel()
+	output, err := exec.CommandContext(ctx, binary, argv...).Output()
+	if err != nil {
+		return fmt.Errorf("configured SSH resolver failed: %w", err)
+	}
+	var result struct {
+		Host    string `json:"host"`
+		Address string `json:"address"`
+	}
+	if err := json.Unmarshal(output, &result); err != nil {
+		return fmt.Errorf("invalid SSH resolver output: %w", err)
+	}
+	ip := net.ParseIP(result.Address)
+	if result.Host == "" || ip == nil || (ipv4 && ip.To4() == nil) || (ipv6 && ip.To4() != nil) {
+		return fmt.Errorf("invalid SSH resolver candidate or address family")
+	}
+	param.addr = joinHostPort(ip.String(), param.port)
+	return nil
+}
+
+func withAutoSession(client SshClient, timeout time.Duration, operation func(SshSession) error) error {
+	type result struct {
+		session SshSession
+		err     error
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	opened := make(chan result)
+	go func() {
+		session, err := client.NewSession()
+		select {
+		case opened <- result{session, err}:
+		case <-ctx.Done():
+			if session != nil {
+				_ = session.Close()
+			}
+		}
+	}()
+	var session SshSession
+	select {
+	case res := <-opened:
+		if res.err != nil {
+			return res.err
+		}
+		session = res.session
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	defer session.Close()
+	done := make(chan error, 1)
+	go func() { done <- operation(session) }()
+	select {
+	case err := <-done:
+		return err
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+func autoLogin(param *sshParam, tty bool) (SshClient, error) {
+	if param.args.Reconnect || param.args.Attach || strings.EqualFold(getExOptionConfig(param.args, "UdpSessionAttach"), "yes") {
+		return nil, fmt.Errorf("automatic transport forbids application relogin and session attachment")
+	}
+	hops, err := buildAutoChain(param)
+	if err != nil {
+		return nil, err
+	}
+	lease := 30 * time.Second
+	for _, hop := range hops {
+		lease += getConnectTimeout(hop.param.args) + 5*hop.budget
+	}
+	if lease > time.Hour {
+		return nil, fmt.Errorf("automatic chain setup budget exceeds one hour")
+	}
+	var committed atomic.Bool
+	ops := autoOperations{}
+	ops.authenticate = func(i int) (SshClient, error) {
+		hop := hops[i]
+		if i > 0 {
+			hop.param.proxy = &proxyJump{hops[i-1].native, hops[i-1].param.args.Destination}
+		}
+		if i == 0 && hop.param.command == "" {
+			if err := resolveAutoOrigin(hop.param); err != nil {
+				return nil, err
+			}
+		}
+		return tcpLogin(hop.param, hop.param.proxy, kUdpModeNo)
+	}
+	ops.prepare = func(i int) (*tsshd.ServerInfo, error) {
+		hop := hops[i]
+		copy := *hop.param
+		copy.udpMode = kUdpModeKcp
+		mtu := uint16(1350)
+		if value := getExOptionConfig(copy.args, "UdpMTU"); value != "" {
+			parsed, err := strconv.ParseUint(value, 10, 16)
+			if err != nil || parsed < 576 || parsed > 1500 {
+				return nil, fmt.Errorf("invalid automatic UdpMTU")
+			}
+			mtu = uint16(parsed)
+		}
+		if mtu < 576 || mtu > 1500 {
+			return nil, fmt.Errorf("automatic KCP UdpMTU must be between 576 and 1500")
+		}
+		if i > 0 {
+			limit, err := tsshd.KCPProxyMTU(hops[i-1].offer.MTU)
+			if err != nil {
+				return nil, err
+			}
+			mtu = min(mtu, limit)
+		}
+		command := getTsshdCommand(&copy, shellescape.Quote(hop.path), mtu, false, hop.budget)
+		fmt.Fprintf(command, " --setup-timeout %d", (lease+time.Second-1)/time.Second)
+		return startTsshdServer(copy.args, hop.native, command.String())
+	}
+	ops.establish = func(i int) (SshClient, error) {
+		hop := hops[i]
+		bind := net.ParseIP(hop.offer.BindAddress)
+		host := bind.String()
+		if bind.IsUnspecified() {
+			metadata, ok := hop.native.(interface{ RemoteAddr() net.Addr })
+			if !ok {
+				return nil, fmt.Errorf("native peer metadata unavailable")
+			}
+			address, _, err := net.SplitHostPort(metadata.RemoteAddr().String())
+			if err != nil || net.ParseIP(address) == nil {
+				return nil, fmt.Errorf("literal authenticated peer address unavailable")
+			}
+			host = address
+		}
+		hop.endpoint = joinHostPort(host, strconv.Itoa(hop.offer.Port))
+		alive := getUdpTimeoutConfig(hop.param.args, "UdpAliveTimeout", 24*time.Hour)
+		heartbeat := getUdpTimeoutConfig(hop.param.args, "UdpHeartbeatTimeout", 8*time.Second)
+		reconnect := getUdpTimeoutConfig(hop.param.args, "UdpReconnectTimeout", kDefaultUdpReconnectTimeout)
+		interval := min(alive/10, min(heartbeat, reconnect)/3)
+		client := &sshUdpClient{intervalTime: interval, aliveTimeout: alive, connectTimeout: hop.budget,
+			reconnectTimeout: reconnect, sshDestName: hop.param.args.Destination}
+		opts := &tsshd.UdpClientOptions{Transactional: true, ServerInfo: hop.offer, TsshdAddr: hop.endpoint,
+			ConnectTimeout: hop.budget, AliveTimeout: alive, HeartbeatTimeout: heartbeat, IntervalTime: interval,
+			EnableDebugging: enableDebugLogging, EnableWarning: enableWarningLogging,
+			DebugFunc:   func(msec int64, msg string) { writeDebugLog(msec, hop.param.args.Destination, msg) },
+			WarningFunc: func(msg string) { warning("udp [%s] %s", hop.param.args.Destination, msg) },
+			QuitCallback: func(reason string) {
+				if !committed.Load() {
+					err := fmt.Errorf("remote setup terminated: %s", reason)
+					hop.quit.Store(&err)
+					return
+				}
+				if conn := client.sshConn.Load(); conn != nil {
+					conn.forceExit(kExitCodeSignalKill, reason)
+				}
+			},
+			ShouldPauseReconnect: shouldPauseReconnect}
+		// SSH direct-tcpip does not transmit AddressFamily to a native jump.
+		// Its authenticated target may use a different family from the root.
+		opts.IPv4 = net.ParseIP(host).To4() != nil
+		opts.IPv6 = !opts.IPv4
+		if i > 0 {
+			client.proxyClient = hops[i-1].udp.(*sshUdpClient)
+			opts.ProxyClient = client.proxyClient.SshUdpClient
+		}
+		client.SshUdpClient, err = tsshd.NewSshUdpClient(opts)
+		if err != nil {
+			return nil, err
+		}
+		return client, nil
+	}
+	ops.barrier = func(i int) error {
+		hop := hops[i]
+		if reason := hop.quit.Load(); reason != nil {
+			return *reason
+		}
+		if !tty && reliableIO(param.args) {
+			client := hop.udp.(*sshUdpClient)
+			if err := client.SetKeepPendingInput(true); err != nil {
+				return err
+			}
+			if err := client.SetKeepPendingOutput(true); err != nil {
+				return err
+			}
+			return client.HeartbeatBarrier(hop.budget)
+		}
+		return nil
+	}
+	ops.commit = func(i int) error {
+		if reason := hops[i].quit.Load(); reason != nil {
+			return *reason
+		}
+		return hops[i].udp.(*sshUdpClient).CommitSetup(hops[i].offer.SetupHandle, hops[i].budget)
+	}
+	ops.cancel = func(i int) error {
+		hop := hops[i]
+		if hop.offer.SetupVersion != 1 || len(hop.offer.SetupHandle) != 64 {
+			return fmt.Errorf("no valid cancellation handle")
+		}
+		return withAutoSession(hop.native, min(hop.budget, 3*time.Second), func(session SshSession) error {
+			return session.Run(shellescape.Quote(hop.path) + " --cancel-setup " + shellescape.Quote(hop.offer.SetupHandle))
+		})
+	}
+	udp, err := selectAutoChain(hops, ops)
+	if err != nil {
+		return nil, err
+	}
+	last := hops[len(hops)-1]
+	*param = *last.param
+	param.udpTransport = udp
+	committed.Store(udp)
+	if udp {
+		lastJumpUdpClient = last.udp.(*sshUdpClient)
+		globalUdpAliveTimeout = lastJumpUdpClient.aliveTimeout
+		if param.args.NoCommand || param.args.Background {
+			lastJumpUdpClient.waitCloseChan = make(chan struct{}, 1)
+		}
+		for _, hop := range hops {
+			client := hop.udp.(*sshUdpClient)
+			go client.udpKeepAlive()
+			addOnExitFunc(func() { _ = client.Close() })
+		}
+		return last.udp, nil
+	}
+	for _, hop := range hops {
+		client := hop.native
+		addOnExitFunc(func() { _ = client.Close() })
+	}
+	return last.native, nil
+}
